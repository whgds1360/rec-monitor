<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SystemMonitor.App"
             RequestedThemeVariant="Dark">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Label">
            <Setter Property="FontFamily" Value="Impact"/>
        </Style>

        <Style Selector="Label.Cpu">
            <Setter Property="Foreground" Value="#00AAFF"/>
        </Style>

        <Style Selector="Label.Cpu.Load">
            <Setter Property="FontSize" Value="22"/>
        </Style>

        <Style Selector="Label.Cpu.Other">
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="Label.Gpu">
            <Setter Property="Foreground" Value="#E8B27DFC"/>
        </Style>

        <Style Selector="Label.Gpu.Load">
            <Setter Property="FontSize" Value="22"/>
        </Style>

        <Style Selector="Label.Gpu.Other">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        
        <Style Selector="Label.Ram">
            <Setter Property="Foreground" Value="#E800FF91"/>
        </Style>

        <Style Selector="Label.Ram.Load">
            <Setter Property="FontSize" Value="22"/>
        </Style>
    </Application.Styles>
</Application>